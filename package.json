{
  "name": "wynnsdk",
  "version": "1.1.0",
  "description": "Unofficial SDK for the Wynncraft API with built-in caching support (Fruma update supported)",
  "main": "src/index.js",
  "types": "index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "index.d.ts",
    "documentation.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --experimental-vm-modules --no-warnings node_modules/jest/bin/jest.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sebastien-Moraz/WynnSDK.git"
  },
  "author": "Sebastien Moraz",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Sebastien-Moraz/WynnSDK/issues"
  },
  "homepage": "https://github.com/Sebastien-Moraz/WynnSDK#readme",
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "wynncraft",
    "wynncraft-api",
    "minecraft",
    "wrapper",
    "sdk",
    "fruma",
    "api"
  ]
}
